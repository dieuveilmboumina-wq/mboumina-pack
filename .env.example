# Copier ce fichier en .env et renseigner les valeurs. Ne jamais versionner .env.

# Base de données — dev : SQLite (prisma/schema.prisma) ; prod : PostgreSQL (prisma/postgres/schema.prisma, généré)
DATABASE_URL="file:./dev.db"

# Aperçu privé (production) : si défini, tout le site est protégé par identifiant/mot de passe et non indexé
PREVIEW_USER="mboumina"
PREVIEW_PASSWORD=""

# URL publique du site (sert aux liens dans les emails, au sitemap, aux webhooks)
APP_URL="http://localhost:3000"

# Secret pour signer les cookies / jetons (32+ caractères aléatoires)
APP_SECRET=""

# Compte fondateur créé au premier lancement du seed (s'il n'existe pas déjà). Changer ce mot de passe depuis « Mon compte » après la première connexion.
FOUNDER_EMAIL=""
FOUNDER_INITIAL_PASSWORD=""

# Emails (laisser vide en dev : les emails sont affichés dans la console)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="MBOUMINA PACK <no-reply@exemple.com>"

# Paiements — à fournir par le fondateur après ouverture des comptes marchands
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET=""
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_WEBHOOK_SECRET=""
CARD_PROVIDER=""            # ex. stripe | cinetpay | paydunya
CARD_PROVIDER_SECRET_KEY=""
CARD_PROVIDER_WEBHOOK_SECRET=""
# Active le simulateur de paiement (UNIQUEMENT en développement/test)
PAYMENT_TEST_MODE="true"

# Assistant IA (Anthropic)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Stockage des fichiers (local en dev)
UPLOAD_DIR="./storage/uploads"
